{
  "name": "bebold",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "BeBold browser extension: bolds the start of each word using the CSS Custom Highlight API.",
  "scripts": {
    "test": "node tools/build-policy.mjs --check && node qa/policy-parity.mjs && node qa/fixtures.mjs && node qa/integration.mjs && node qa/e2e.mjs",
    "fixtures": "node qa/fixtures.mjs",
    "integration": "node qa/integration.mjs",
    "e2e": "node qa/e2e.mjs",
    "qa": "node qa/qa.mjs",
    "qa:shots": "node qa/qa.mjs --shots",
    "catalog": "node qa/catalog.mjs",
    "spike": "node spike/run-spike.mjs",
    "coverage:1.4": "node spike/coverage.mjs",
    "build:policy": "node tools/build-policy.mjs",
    "parity": "node qa/policy-parity.mjs",
    "package": "node tools/package.mjs",
    "store:shots": "node tools/store-shots.mjs"
  },
  "devDependencies": {
    "pixelmatch": "^7.1.0",
    "playwright": "^1.57.0",
    "pngjs": "^7.0.0"
  }
}
